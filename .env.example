# ============================================================================
# Classificado Pilates — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# Para produção, configure essas variáveis no painel do seu host (DO, Vercel).
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (obrigatório)
# ----------------------------------------------------------------------------
# Obtidos em: Supabase Dashboard → Project Settings → API
# - NEXT_PUBLIC_* são expostas ao client (seguras)
# - SUPABASE_SERVICE_ROLE_KEY é SECRETA — nunca exponha no client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# ----------------------------------------------------------------------------
# Site (obrigatório)
# ----------------------------------------------------------------------------
# URL absoluta do site. Usada em links de email, OG tags, webhooks.
# Local: http://localhost:3000
# Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Evolution API — WhatsApp (obrigatório para envio de mensagens)
# ----------------------------------------------------------------------------
# Self-hosted Evolution API (Baileys). Ver docs/DEPLOYMENT-DIGITALOCEAN.md
# - EVOLUTION_API_URL: URL do servidor Evolution (interno em Docker: http://evolution:8080)
# - EVOLUTION_API_KEY: chave configurada em AUTHENTICATION_API_KEY do Evolution
# - EVOLUTION_INSTANCE_NAME: nome da instância criada (ex: classificado-pilates)
EVOLUTION_API_URL=https://wa.your-domain.com
EVOLUTION_API_KEY=your-evolution-api-key-here
EVOLUTION_INSTANCE_NAME=classificado-pilates
