# ============================================================================
# Loja Oficial Metalife Pilates — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele está no .gitignore.
# Para produção, configure essas variáveis no painel do seu host (DO, Vercel).
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (obrigatório)
# ----------------------------------------------------------------------------
# Obtidos em: Supabase Dashboard → Project Settings → API
# - NEXT_PUBLIC_* são expostas ao client (seguras)
# - SUPABASE_SERVICE_ROLE_KEY é SECRETA — nunca exponha no client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR...

# ----------------------------------------------------------------------------
# Site (obrigatório)
# ----------------------------------------------------------------------------
# URL absoluta do site. Usada em links de email, OG tags, webhooks.
# Local: http://localhost:3000
# Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial oficial (botão "Falar com Especialista")
# Somente dígitos com DDI, ex: 5511999999999
NEXT_PUBLIC_OFFICIAL_WHATSAPP=

# ----------------------------------------------------------------------------
# Evolution API — WhatsApp (opcional; desabilitada por padrão)
# ----------------------------------------------------------------------------
# Sem EVOLUTION_API_URL / EVOLUTION_API_KEY o fluxo de pedidos e cadastro
# continua normal — apenas o disparo automático fica desligado.
# EVOLUTION_API_URL=https://wa.your-domain.com
# EVOLUTION_API_KEY=your-evolution-api-key-here
# EVOLUTION_INSTANCE_NAME=metalife
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=metalife

# ----------------------------------------------------------------------------
# Asaas — pagamentos (opcional em dev; sem chave usa mock)
# ----------------------------------------------------------------------------
ASAAS_API_KEY=your-asaas-api-key
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=dev-webhook-token
# Exposto só para o botão "Simular pagamento" no checkout mock
NEXT_PUBLIC_ASAAS_WEBHOOK_TOKEN=dev-webhook-token
